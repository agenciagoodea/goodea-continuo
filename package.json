{
  "name": "goodea-continuo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "test:local": "node scripts/smoke-local.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1"
  }
}
